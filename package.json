{
  "name": "webpage-viz-differ",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @webpage-viz-differ/core build && pnpm --filter @webpage-viz-differ/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @webpage-viz-differ/core test",
    "test:e2e": "pnpm --filter @webpage-viz-differ/web test:e2e",
    "typecheck": "pnpm --filter @webpage-viz-differ/core build && pnpm -r typecheck",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
