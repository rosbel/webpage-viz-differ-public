{
  "name": "@webpage-viz-differ/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Visual comparison engine: capture two live sites with Playwright, diff with pixelmatch, store runs in SQLite",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "jiti": "^2.6.0",
    "pixelmatch": "^7.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
